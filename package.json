{
  "name": "blog",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "./dev.sh start",
    "dev:admin": "cd admin && npm run dev",
    "build": "bash scripts/build.sh",
    "build:css": "tailwindcss --input src/tailwind-input.css --output public/css/tailwind.css --minify",
    "build:deploy": "bash scripts/build.sh",
    "deploy": "bash scripts/deploy.sh",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "node scripts/migrate.mjs",
    "db:migrate:prod": "node scripts/migrate.mjs --production",
    "d1:create": "wrangler d1 create blog-db-prod",
    "r2:create": "wrangler r2 bucket create blog-images",
    "secret:set": "wrangler secret put --env production",
    "test": "vitest run",
    "test:api": "vitest run tests/api",
    "test:ui": "vitest run tests/ui",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.6",
    "drizzle-orm": "^0.45.4",
    "highlight.js": "^11.11.1",
    "hono": "^4.13.13",
    "katex": "^0.18.10",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261008.1",
    "@emnapi/core": "1.9.1",
    "@emnapi/runtime": "1.9.1",
    "@tailwindcss/cli": "^4.3.0",
    "@types/katex": "^0.16.8",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.149.0",
    "@cloudflare/vitest-plugin": "^1.4.0"
  },
  "overrides": {
    "esbuild": "$esbuild"
  }
}
